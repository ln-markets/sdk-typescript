# Target network for the test suite. Defaults to signet when unset.
# Set to 'mainnet' to opt into the MAINNET_* credentials below.
NETWORK=signet

# Signet credentials (used when NETWORK=signet or unset).
SIGNET_API_KEY=
SIGNET_API_SECRET=
SIGNET_API_PASSPHRASE=

# Mainnet credentials (used when NETWORK=mainnet).
MAINNET_API_KEY=
MAINNET_API_SECRET=
MAINNET_API_PASSPHRASE=
