# Target network for the test suite. Defaults to testnet4 when unset.
# Set to 'mainnet' to opt into the MAINNET_* credentials below.
NETWORK=testnet4

# Testnet4 credentials (used when NETWORK=testnet4 or unset).
TESTNET4_API_KEY=
TESTNET4_API_KEY_SECRET=
TESTNET4_API_KEY_PASSPHRASE=

# Mainnet credentials (used when NETWORK=mainnet).
MAINNET_API_KEY=
MAINNET_API_SECRET=
MAINNET_API_PASSPHRASE=
