{
  "name": "@ln-markets/sdk",
  "version": "2.2.0",
  "description": "TypeScript SDK for LNMarkets API",
  "keywords": [
    "api",
    "bitcoin",
    "lightning",
    "ln-markets",
    "sdk",
    "trading"
  ],
  "homepage": "https://github.com/ln-markets/sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/ln-markets/sdk-typescript/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ln-markets/sdk-typescript.git"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "package.json",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    "./rest/v3": {
      "import": "./dist/rest/v3/index.js",
      "types": "./dist/rest/v3/index.d.ts"
    },
    "./stream/v1": {
      "import": "./dist/stream/v1/index.js",
      "types": "./dist/stream/v1/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "check": "./scripts/check.sh",
    "check:security": "./scripts/check-security.sh",
    "fix": "nub run format:fix && nub run lint:fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "knip": "knip --cache --cache-location node_modules/.cache/knip",
    "lint": "oxlint --quiet --type-aware --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --quiet --type-aware --report-unused-disable-directives-severity=error --fix --fix-dangerously --fix-suggestions",
    "markdownlint": "markdownlint --ignore-path .gitignore '**/*.md'",
    "prepublishOnly": "./scripts/pre-release.sh",
    "release": "np",
    "spell-check": "cspell --show-context --no-progress --cache --cache-location node_modules/.cache/cspell '**'",
    "test": "vitest --run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "eventemitter3": "5.0.4",
    "ky": "2.2.0",
    "ts-pattern": "5.9.2",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "cspell": "10.4.0",
    "knip": "6.44.1",
    "markdownlint-cli": "0.50.0",
    "np": "12.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26.8.1",
    "pnpm": "12.3.4"
  },
  "packageManager": "pnpm@12.3.4"
}
